cxx.std = latest

using cxx

# Upstream's d3d12.h uses anonymous structs in anonymous unions, a common
# Windows-header idiom that -pedantic flags as a Clang extension.
#
if ($cxx.id.type == 'clang')
  cxx.coptions += -Wno-nested-anon-types

hxx{*}: extension = hpp
ixx{*}: extension = ipp
txx{*}: extension = tpp
cxx{*}: extension = cpp

# Every exe{} in this subproject is by default a test.
#
exe{*}: test = true

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target
